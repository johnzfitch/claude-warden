#!/usr/bin/env bash
# stop: Handle stop events with duration tracking
set -euo pipefail

# Source shared library
source "${BASH_SOURCE[0]%/*}/lib/common.sh"

LOG_FILE="$HOME/.claude/session-log.txt"
_warden_read_input || exit 0

# CRITICAL: Check if stop hook is already active to prevent infinite loops
STOP_HOOK_ACTIVE=$(printf '%s' "$WARDEN_INPUT" | jq -r '.stop_hook_active // false' 2>/dev/null)
[[ "$STOP_HOOK_ACTIVE" == "true" ]] && exit 0

IFS=$'\t' read -r REASON TOOL_NAME SESSION_ID < <(
    printf '%s' "$WARDEN_INPUT" | jq -r '[.reason // "unknown", .tool_name // "", .session_id // ""] | @tsv' 2>/dev/null
) || exit 0

SESSION_ID=$(_warden_sanitize_id "$SESSION_ID")
_warden_resolve_session_start "$SESSION_ID"

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Calculate session duration
DURATION="unknown"
SESSION_TIME_FILE="$HOME/.claude/.session-times/$SESSION_ID.start"
if [ -n "$SESSION_ID" ] && [ -f "$SESSION_TIME_FILE" ]; then
  START_TIME=$(_warden_read_numeric "$SESSION_TIME_FILE" "$_WARDEN_NOW_S")
  END_TIME=$(date +%s)
  DURATION_SECS=$((END_TIME - START_TIME))
  DURATION="${DURATION_SECS}s"
fi

# Log stop event with duration
if [[ -n "$TOOL_NAME" ]]; then
  echo "[$TIMESTAMP] Stop: $REASON (tool: $TOOL_NAME, duration: $DURATION)" >> "$LOG_FILE"
else
  echo "[$TIMESTAMP] Stop: $REASON (duration: $DURATION)" >> "$LOG_FILE"
fi

# Emit to collector
_TS=$((_WARDEN_NOW_S - _WARDEN_SESSION_START_S))
_REASON_SAFE="$REASON"
_warden_json_escape _REASON_SAFE
_evt=""
printf -v _evt '{"timestamp":%d,"event_type":"session_stop","tool":"Stop","session_id":"%s","reason":"%s","duration_seconds":%d}' \
  "$_TS" "$SESSION_ID" "$_REASON_SAFE" "${DURATION_SECS:-0}"
_warden_post_to_collector "$_evt"

# === AUTONOMOUS RESPONSE DETECTION ===
# Check if the preceding user message was non-human (task-notification, etc.).
# Claude Code project dirs use CWD with / -> - as the key.
_PROJECT_KEY=$(printf '%s' "$PWD" | tr '/' '-')
_JSONL="$HOME/.claude/projects/${_PROJECT_KEY}/${SESSION_ID}.jsonl"
if [[ -f "$_JSONL" ]]; then
    # Find the last user message origin (tail enough lines to catch it past progress/system noise)
    _LAST_ORIGIN=$(tail -30 "$_JSONL" \
        | jq -r 'select(.type == "user") | .origin.kind // "human"' 2>/dev/null \
        | tail -1)
    if [[ -n "$_LAST_ORIGIN" && "$_LAST_ORIGIN" != "human" ]]; then
        # Extract the assistant response that followed the non-human trigger
        _RESPONSE_PREVIEW=$(tail -10 "$_JSONL" \
            | jq -r 'select(.type == "assistant") | .message.content[0].text // "" | .[0:200]' 2>/dev/null \
            | tail -1)
        _warden_json_escape _RESPONSE_PREVIEW
        _REQ_ID=$(tail -10 "$_JSONL" \
            | jq -r 'select(.type == "assistant") | .requestId // ""' 2>/dev/null \
            | tail -1)
        printf -v _auto_evt '{"timestamp":%d,"event_type":"autonomous_response","tool":"Stop","session_id":"%s","origin":"%s","request_id":"%s","response_preview":"%s"}' \
            "$_TS" "$SESSION_ID" "$_LAST_ORIGIN" "$_REQ_ID" "$_RESPONSE_PREVIEW"
        _warden_post_to_collector "$_auto_evt"
        _warden_notify critical "Warden: Autonomous Response" \
            "Claude responded to a ${_LAST_ORIGIN} trigger without user input. Review the last turn."
        _WARDEN_AUTO_WARNING="[warden] The previous response was triggered by '${_LAST_ORIGIN}', not by you. It may not reflect your intent -- review before acting on it."
    fi
fi

# Build stop_hook_summary (shown in Claude UI on session completion)
if [[ -n "${_WARDEN_AUTO_WARNING:-}" ]]; then
    # Inject warning into both the summary and additionalContext so Claude sees it
    jq -n \
      --arg s "Session: ${DURATION_SECS:-0}s | reason: $REASON" \
      --arg warn "$_WARDEN_AUTO_WARNING" \
      '{"stop_hook_summary": $s, "hookSpecificOutput":{"hookEventName":"Stop","additionalContext":$warn}}'
else
    jq -n \
      --arg s "Session: ${DURATION_SECS:-0}s | reason: $REASON" \
      '{"stop_hook_summary": $s}'
fi
