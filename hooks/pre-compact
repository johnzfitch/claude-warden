#!/usr/bin/env bash
# pre-compact: Inject warden state summary before context compaction
# Ensures budget tracking and session state survive compaction
set -euo pipefail

# Source shared library
source "${BASH_SOURCE[0]%/*}/lib/common.sh"

_warden_read_input || exit 0

SESSION_ID=$(_warden_parse_session_id)
SESSION_ID=$(_warden_sanitize_id "$SESSION_ID")
[[ -z "$SESSION_ID" ]] && exit 0
_warden_resolve_session_start "$SESSION_ID"

# === GATHER SESSION STATE FROM COLLECTOR ===
SESSION_START_FILE="$HOME/.claude/.session-times/$SESSION_ID.start"
COLLECTOR_SOCK="${WARDEN_COLLECTOR_SOCK:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-warden/collector.sock}"

TOOL_COUNT=0
SUBAGENT_COUNT=0
if [[ -S "$COLLECTOR_SOCK" ]]; then
    COLLECTOR_JSON=$(curl -sf --max-time 0.1 \
        --unix-socket "$COLLECTOR_SOCK" \
        "http://localhost/v1/sessions/${SESSION_ID}/context" 2>/dev/null) || COLLECTOR_JSON=""
    if [[ -n "$COLLECTOR_JSON" ]]; then
        TOOL_COUNT=$(printf '%s' "$COLLECTOR_JSON" | jq -r '.tool_count // 0')
        SUBAGENT_COUNT=$(printf '%s' "$COLLECTOR_JSON" | jq -r '.subagent_count // 0')
    fi
fi

# Session duration
DURATION_MIN="unknown"
if [[ -f "$SESSION_START_FILE" ]]; then
    START_TIME=$(_warden_read_numeric "$SESSION_START_FILE" "$_WARDEN_NOW_S")
    NOW=$(date +%s)
    DURATION_SEC=$((NOW - START_TIME))
    DURATION_MIN=$((DURATION_SEC / 60))
fi

# Budget state
BUDGET_JSON=$(_warden_budget_export 2>/dev/null || echo '{}')
UTIL=$(echo "$BUDGET_JSON" | jq -r '.utilization // 0' | cut -d. -f1)
CONSUMED=$(echo "$BUDGET_JSON" | jq -r '.consumed // 0')
TOTAL=$(echo "$BUDGET_JSON" | jq -r '.total_limit // 0')
BUDGET_STATUS="${UTIL}% (${CONSUMED}/${TOTAL})"

# === CONSTRUCT SUMMARY ===
SUMMARY="[Warden Session State]
- Tool calls: $TOOL_COUNT
- Duration: ${DURATION_MIN}m
- Active subagents: $SUBAGENT_COUNT
- Budget: $BUDGET_STATUS"

# === EMIT COMPACTION EVENT ===
_TS=$((_WARDEN_NOW_S - _WARDEN_SESSION_START_S))
_evt=""
printf -v _evt '{"timestamp":%d,"event_type":"compaction","tool":"PreCompact","session_id":"%s","tool_count":%d}' \
    "$_TS" "$SESSION_ID" "$TOOL_COUNT"
_warden_post_to_collector "$_evt"

# === INJECT INTO COMPACTION CONTEXT ===
jq -n --arg ctx "$SUMMARY" '{"systemMessage":$ctx}'

exit 0
