#!/usr/bin/env bash
# aurl - safe curl wrapper for Claude Code
# Rewrites curl with safety guards: allows localhost, blocks cloud metadata,
# blocks data uploads to remote servers, auto-adds -sS and --max-time.
#
# Invoked automatically by pre-tool-use hook (curl -> aurl rewrite).
# Models should not call aurl directly.

set -o pipefail

# --- Parse curl args: find URL and detect data upload flags ---
_URL=""
_HAS_DATA=false
_URL_NEXT=false
_METHOD=""
_METHOD_NEXT=false

for arg in "$@"; do
    if $_URL_NEXT; then
        [[ -z "$_URL" ]] && _URL="$arg"
        _URL_NEXT=false
        continue
    fi
    if $_METHOD_NEXT; then
        _METHOD=$(printf '%s' "$arg" | tr '[:lower:]' '[:upper:]')
        _METHOD_NEXT=false
        continue
    fi
    case "$arg" in
        # URL detection
        http://*|https://*)
            [[ -z "$_URL" ]] && _URL="$arg" ;;
        --url) _URL_NEXT=true ;;
        --url=*) [[ -z "$_URL" ]] && _URL="${arg#--url=}" ;;

        # Data upload flags (long form with = or separate arg)
        -d|--data|--data-binary|--data-raw|--data-urlencode|-F|--form|--upload-file|-T)
            _HAS_DATA=true ;;
        -d*|--data=*|--data-binary=*|--data-raw=*|--data-urlencode=*|-F*|--form=*|--upload-file=*|-T*)
            _HAS_DATA=true ;;

        # Explicit HTTP method
        -X|--request)
            _METHOD_NEXT=true ;;
        -X*)
            _METHOD=$(printf '%s' "${arg#-X}" | tr '[:lower:]' '[:upper:]') ;;
        --request=*)
            _METHOD=$(printf '%s' "${arg#--request=}" | tr '[:lower:]' '[:upper:]') ;;
    esac
done

# --- Classify target ---
_URL_LOWER=$(printf '%s' "$_URL" | tr '[:upper:]' '[:lower:]')

# Cloud metadata endpoints - always block
if [[ "$_URL_LOWER" =~ 169\.254\.169\.254 ]] || \
   [[ "$_URL_LOWER" =~ metadata\.google\.internal ]] || \
   [[ "$_URL_LOWER" =~ 169\.254\.169\.250 ]] || \
   [[ "$_URL_LOWER" =~ 100\.100\.100\.200 ]]; then
    echo "aurl: blocked cloud metadata endpoint: $_URL" >&2
    exit 1
fi

# Localhost/loopback detection
_IS_LOCALHOST=false
if [[ "$_URL_LOWER" =~ ^https?://(localhost|127\.[0-9]+\.[0-9]+\.[0-9]+|0\.0\.0\.0|\[::1\])(:[0-9]+)?(/|$|\?) ]]; then
    _IS_LOCALHOST=true
fi

# Private RFC1918 ranges - block (non-localhost internal networks)
if [[ "$_IS_LOCALHOST" == false ]] && \
   [[ "$_URL_LOWER" =~ ^https?://(10\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+|192\.168\.[0-9]+)\.[0-9]+ ]]; then
    echo "aurl: blocked private network address: $_URL" >&2
    echo "aurl: only localhost services are allowed from model context" >&2
    exit 1
fi

# Data uploads to non-localhost - block
if [[ "$_HAS_DATA" == true ]] && [[ "$_IS_LOCALHOST" == false ]]; then
    echo "aurl: blocked data upload to remote server: $_URL" >&2
    echo "aurl: POST/form/upload only allowed to localhost services" >&2
    exit 1
fi

if [[ "$_IS_LOCALHOST" == false ]] && [[ "$_METHOD" =~ ^(POST|PUT|PATCH|DELETE)$ ]]; then
    echo "aurl: blocked remote ${_METHOD} request to: $_URL" >&2
    echo "aurl: only GET/HEAD requests are allowed to remote servers" >&2
    exit 1
fi

# --- Build safe curl invocation ---
_EXTRA=()

# Auto-add -sS so success stays quiet but curl diagnostics still surface
_HAS_S=false
for arg in "$@"; do
    case "$arg" in -s|--silent|-s*) _HAS_S=true; break ;; esac
done
[[ "$_HAS_S" == false ]] && _EXTRA+=("-sS")

# Auto-add --max-time if no timeout set
_HAS_T=false
for arg in "$@"; do
    case "$arg" in -m|--max-time|--connect-timeout) _HAS_T=true; break ;; esac
done
[[ "$_HAS_T" == false ]] && _EXTRA+=("--max-time" "30")

exec curl "${_EXTRA[@]}" "$@"
