#!/usr/bin/env bash
# session-start: Track session and terminal agent start
set -euo pipefail

# Source shared library
source "${BASH_SOURCE[0]%/*}/lib/common.sh"

# Start collector if not running (once per session, not per tool call)
_warden_ensure_collector

_warden_read_input || exit 0

SESSION_ID=$(_warden_parse_session_id)
SESSION_ID=$(_warden_sanitize_id "$SESSION_ID")
AGENT_STATS="$HOME/.claude/agent-stats.csv"

if [ -n "$SESSION_ID" ]; then
  mkdir -p "$HOME/.claude/.session-times"
  mkdir -p "$WARDEN_SESSION_BUDGET_DIR"
  date +%s > "$HOME/.claude/.session-times/$SESSION_ID.start"
  _warden_date_sns > "$HOME/.claude/.session-times/$SESSION_ID.start_ns"
  # Warden TUI: record session start for relative timestamps
  # Per-session file only. Global file removed to prevent concurrent sessions
  # from overwriting each other's timestamps (common.sh falls back to date +%s).
  mkdir -p "$WARDEN_STATE_DIR"
  _warden_date_sns > "$WARDEN_STATE_DIR/.session_start-$SESSION_ID"

  # Snapshot budget at session start
  _warden_budget_export > "$WARDEN_SESSION_BUDGET_DIR/$SESSION_ID.start.json" 2>/dev/null || true
  _warden_write_budget_prom

  # Initialize unified agent stats CSV with header if needed
  if [ ! -f "$AGENT_STATS" ]; then
    echo "timestamp,agent_id,agent_category,agent_type,duration_seconds,session_id,status" > "$AGENT_STATS"
  fi

  # Log terminal agent start
  echo "$(_warden_date_iso),terminal-$SESSION_ID,terminal,main,0,$SESSION_ID,started" >> "$AGENT_STATS"

  # Emit session_start event to events.jsonl for Loki/Grafana
  # session_label: "dirname (last6 of session_id)" — used in Session Index/Detail dashboards
  SESSION_LABEL="$(basename "$PWD") (${SESSION_ID: -6})"
  _CWD_SAFE="$PWD"
  _warden_json_escape _CWD_SAFE
  _warden_json_escape SESSION_LABEL
  local _evt
  printf -v _evt '{"timestamp":0,"event_type":"session_start","tool":"SessionStart","session_id":"%s","cwd":"%s","session_label":"%s"}' \
    "$SESSION_ID" "$_CWD_SAFE" "$SESSION_LABEL"
  echo "$_evt" >> "$WARDEN_EVENTS_FILE" 2>/dev/null
  _warden_post_to_collector "$_evt"
fi

# === GIT CONTEXT SNAPSHOT ===
# Inject branch, dirty count, and last commit so the model doesn't need
# to spend a tool call on git status/log to orient itself.
if git rev-parse --is-inside-work-tree &>/dev/null; then
  GIT_BRANCH=$(git branch --show-current 2>/dev/null)
  [[ -z "$GIT_BRANCH" ]] && GIT_BRANCH="detached"
  GIT_DIRTY=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  GIT_LAST=$(git log -1 --format='%h %s' 2>/dev/null || echo "")

  CTX="[Git] ${GIT_BRANCH}"
  (( GIT_DIRTY > 0 )) && CTX+=" (${GIT_DIRTY} dirty)"
  [[ -n "$GIT_LAST" ]] && CTX+=", last: ${GIT_LAST}"

  jq -n --arg ctx "$CTX" \
    '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":$ctx}}'
fi

exit 0
