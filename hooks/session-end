#!/usr/bin/env bash
# session-end: Track terminal agent completion, session cleanup, and stop events
# Handles both SessionEnd and Stop lifecycle events (merged from hooks/stop)
set -euo pipefail

# Source shared library
source "${BASH_SOURCE[0]%/*}/lib/common.sh"

LOG_FILE="$HOME/.claude/session-log.txt"
RESET_REASON_FILE=""  # Set after SESSION_ID is parsed below
AGENT_STATS="$HOME/.claude/agent-stats.csv"
SESSION_COST_LOG="$HOME/.claude/.monitoring/session-costs.csv"

_warden_read_input || exit 0

# === STOP EVENT HANDLING (merged from hooks/stop) ===
# Detect Stop event by presence of stop_hook_active field (boolean).
# SessionEnd payloads have only session_id + reason.
# Stop payloads always include stop_hook_active (true or false).
# Reject null/non-boolean to prevent malformed payloads from misrouting.
_STOP_HOOK_ACTIVE=$(printf '%s' "$WARDEN_INPUT" | jq -r 'if has("stop_hook_active") and (.stop_hook_active | type == "boolean") then (.stop_hook_active | tostring) else "absent" end' 2>/dev/null)
if [[ "$_STOP_HOOK_ACTIVE" != "absent" ]]; then
    # CRITICAL: Prevent infinite loops
    [[ "$_STOP_HOOK_ACTIVE" == "true" ]] && exit 0

    IFS=$'\t' read -r _STOP_REASON _STOP_TOOL _STOP_SID < <(
        printf '%s' "$WARDEN_INPUT" | jq -r '[.reason // "unknown", .tool_name // "", .session_id // ""] | @tsv' 2>/dev/null
    ) || exit 0

    _STOP_SID=$(_warden_sanitize_id "$_STOP_SID")
    _warden_resolve_session_start "$_STOP_SID"

    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

    # Calculate session duration
    DURATION="unknown"
    DURATION_SECS=0
    SESSION_TIME_FILE="$HOME/.claude/.session-times/$_STOP_SID.start"
    if [ -n "$_STOP_SID" ] && [ -f "$SESSION_TIME_FILE" ]; then
        START_TIME=$(_warden_read_numeric "$SESSION_TIME_FILE" "$_WARDEN_NOW_S")
        END_TIME=$(date +%s)
        DURATION_SECS=$((END_TIME - START_TIME))
        DURATION="${DURATION_SECS}s"
    fi

    # Log stop event with duration
    if [[ -n "$_STOP_TOOL" ]]; then
        echo "[$TIMESTAMP] Stop: $_STOP_REASON (tool: $_STOP_TOOL, duration: $DURATION)" >> "$LOG_FILE"
    else
        echo "[$TIMESTAMP] Stop: $_STOP_REASON (duration: $DURATION)" >> "$LOG_FILE"
    fi

    # Emit to collector
    _TS=$((_WARDEN_NOW_S - _WARDEN_SESSION_START_S))
    _REASON_SAFE="$_STOP_REASON"
    _warden_json_escape _REASON_SAFE
    printf -v _evt '{"timestamp":%d,"event_type":"session_stop","tool":"Stop","session_id":"%s","reason":"%s","duration_seconds":%d}' \
        "$_TS" "$_STOP_SID" "$_REASON_SAFE" "${DURATION_SECS:-0}"
    _warden_post_to_collector "$_evt"

    # === AUTONOMOUS RESPONSE DETECTION ===
    _PROJECT_KEY=$(printf '%s' "$PWD" | tr '/' '-')
    _JSONL="$HOME/.claude/projects/${_PROJECT_KEY}/${_STOP_SID}.jsonl"
    _WARDEN_AUTO_WARNING=""
    if [[ -f "$_JSONL" ]]; then
        _LAST_ORIGIN=$(tail -30 "$_JSONL" \
            | jq -r 'select(.type == "user") | .origin.kind // "human"' 2>/dev/null \
            | tail -1)
        if [[ -n "$_LAST_ORIGIN" && "$_LAST_ORIGIN" != "human" ]]; then
            _RESPONSE_PREVIEW=$(tail -10 "$_JSONL" \
                | jq -r 'select(.type == "assistant") | .message.content[0].text // "" | .[0:200]' 2>/dev/null \
                | tail -1)
            _warden_json_escape _RESPONSE_PREVIEW
            _REQ_ID=$(tail -10 "$_JSONL" \
                | jq -r 'select(.type == "assistant") | .requestId // ""' 2>/dev/null \
                | tail -1)
            printf -v _auto_evt '{"timestamp":%d,"event_type":"autonomous_response","tool":"Stop","session_id":"%s","origin":"%s","request_id":"%s","response_preview":"%s"}' \
                "$_TS" "$_STOP_SID" "$_LAST_ORIGIN" "$_REQ_ID" "$_RESPONSE_PREVIEW"
            _warden_post_to_collector "$_auto_evt"
            _warden_notify critical "Warden: Autonomous Response" \
                "Claude responded to a ${_LAST_ORIGIN} trigger without user input. Review the last turn."
            _WARDEN_AUTO_WARNING="[warden] The previous response was triggered by '${_LAST_ORIGIN}', not by you. It may not reflect your intent -- review before acting on it."
        fi
    fi

    # Build stop_hook_summary
    if [[ -n "${_WARDEN_AUTO_WARNING:-}" ]]; then
        jq -n \
            --arg s "Session: ${DURATION_SECS:-0}s | reason: $_STOP_REASON" \
            --arg warn "$_WARDEN_AUTO_WARNING" \
            '{"stop_hook_summary": $s, "hookSpecificOutput":{"hookEventName":"Stop","additionalContext":$warn}}'
    else
        jq -n \
            --arg s "Session: ${DURATION_SECS:-0}s | reason: $_STOP_REASON" \
            '{"stop_hook_summary": $s}'
    fi
    exit 0
fi
# === END STOP EVENT HANDLING ===

# Extract session info
IFS=$'\t' read -r SESSION_ID REASON < <(
    printf '%s' "$WARDEN_INPUT" | jq -r '[.session_id // "unknown", .reason // ""] | @tsv' 2>/dev/null
) || exit 0
SESSION_ID=$(_warden_sanitize_id "$SESSION_ID")
[[ -z "$SESSION_ID" ]] && SESSION_ID="unknown"
_warden_resolve_session_start "$SESSION_ID"
SESSION_PROM_FILE="$HOME/.claude/.monitoring/textfile/claude-code-session-${SESSION_ID}.prom"
RESET_REASON_FILE="$WARDEN_STATE_DIR/reset-reason${SESSION_ID:+-$SESSION_ID}"

# Calculate terminal agent duration
SESSION_START_FILE="$HOME/.claude/.session-times/$SESSION_ID.start"
if [ -f "$SESSION_START_FILE" ]; then
  START_EPOCH=$(_warden_read_numeric "$SESSION_START_FILE" "$_WARDEN_NOW_S")
  END_EPOCH=$(date +%s)
  DURATION=$((END_EPOCH - START_EPOCH))
  DURATION_MIN=$((DURATION / 60))

  # Log terminal agent completion
  echo "$(_warden_date_iso),terminal-$SESSION_ID,terminal,main,$DURATION,$SESSION_ID,completed" >> "$AGENT_STATS"

  # Emit session_end event to events.jsonl for Loki/Grafana
  _TS=$((_WARDEN_NOW_S - _WARDEN_SESSION_START_S))
  _evt=""
  printf -v _evt '{"timestamp":%d,"event_type":"session_end","tool":"SessionEnd","session_id":"%s","duration_seconds":%d}' \
    "$_TS" "$SESSION_ID" "$DURATION"
  _warden_post_to_collector "$_evt"

  # Track budget delta for this session
  START_BUDGET_FILE="$WARDEN_SESSION_BUDGET_DIR/$SESSION_ID.start.json"
  if [ -f "$START_BUDGET_FILE" ]; then
    START_CONSUMED=$(jq -r '.consumed // 0' "$START_BUDGET_FILE" 2>/dev/null || echo 0)
    END_JSON=$(_warden_budget_export)
    END_CONSUMED=$(echo "$END_JSON" | jq -r '.consumed // 0')
    DELTA=$((END_CONSUMED - START_CONSUMED))
    (( DELTA < 0 )) && DELTA=0  # Budget was reset mid-session; clamp

    # Initialize CSV if needed
    mkdir -p "$(dirname "$SESSION_COST_LOG")"
    if [ ! -f "$SESSION_COST_LOG" ]; then
      echo "timestamp,session_id,duration_seconds,budget_start,budget_end,budget_delta,subagent_count" > "$SESSION_COST_LOG"
    fi

    # Count subagents for this session
    SUBAGENT_COUNT=$(awk -F',' -v sid="$SESSION_ID" \
        '$6 == sid && $3 == "subagent" && $7 == "completed" { count++ } END { print count+0 }' \
        "$AGENT_STATS" 2>/dev/null)

    # Log session cost
    echo "$(_warden_date_iso),$SESSION_ID,$DURATION,$START_CONSUMED,$END_CONSUMED,$DELTA,$SUBAGENT_COUNT" >> "$SESSION_COST_LOG"

    # Cleanup budget snapshot
    rm -f "$START_BUDGET_FILE"
  fi
else
  DURATION="unknown"
  DURATION_MIN="unknown"
fi

END_TIME=$(date '+%Y-%m-%d %H:%M:%S')

# === GHOST SUBAGENT REAPER ===
# Clean up orphaned subagent state from THIS session only (safe with concurrent sessions)
if [[ -d "$WARDEN_SUBAGENT_STATE_DIR" ]]; then
    for state_file in "$WARDEN_SUBAGENT_STATE_DIR"/*; do
        [ -f "$state_file" ] && [ ! -L "$state_file" ] || continue
        [[ "$(basename "$state_file")" == *.* ]] && continue  # skip .start and session- files
        grep -q "^SESSION_ID=${SESSION_ID}$" "$state_file" 2>/dev/null || continue
        rm -f "$state_file" "$state_file.start"
    done
fi

# === STATE FILE CLEANUP ===
# Purge stale state files older than 24 hours.
# Covers all per-session and per-invocation scratch patterns to prevent
# unbounded file accumulation (previously missed .tool-start-*, .quiet-override-*,
# clears-*, peak-*, .session_start-*).
if [[ -d "$WARDEN_STATE_DIR" ]]; then
    for _pat in 'tool-count-*' 'tool-top-*' 'session-*' 'state-*' '.tool-start-*' \
                '.quiet-override-*' 'clears-*' 'peak-*' '.session_start-*' \
                'startup-model-*' 'subagent-count-*'; do
        find "$WARDEN_STATE_DIR" -maxdepth 1 -type f -name "$_pat" -mtime +0 -exec rm -f {} + 2>/dev/null || true
    done
    # Stale locks: flock files + legacy mkdir lock dirs
    find "$WARDEN_STATE_DIR" -maxdepth 1 -type f -name '*.lock' -mmin +60 -exec rm -f {} + 2>/dev/null || true
    find "$WARDEN_STATE_DIR" -maxdepth 1 -type d -name '*.lock.d' -mmin +60 -exec rm -rf {} + 2>/dev/null || true
fi
if [[ -d "$WARDEN_SUBAGENT_STATE_DIR" ]]; then
    find "$WARDEN_SUBAGENT_STATE_DIR" -maxdepth 1 -type f -name '*.start' -mtime +0 -exec rm -f {} + 2>/dev/null || true
    find "$WARDEN_SUBAGENT_STATE_DIR" -maxdepth 1 -type f ! -name '.*' -mtime +0 -exec rm -f {} + 2>/dev/null || true
fi

# Log session end with enhanced reason tracking
# New in 2.1.70: bypass_permissions_disabled reason
REASON_DISPLAY="$REASON"
case "$REASON" in
    bypass_permissions_disabled)
        REASON_DISPLAY="bypass mode disabled"
        ;;
esac

echo "[$END_TIME] Session ended: $SESSION_ID (duration: ${DURATION_MIN}m, dir: $PWD, reason: $REASON_DISPLAY)" >> "$LOG_FILE"

# Record reset reason for statusline
if [ -n "$REASON" ]; then
    mkdir -p "$WARDEN_STATE_DIR"
    printf '%s|%s|%s\n' "$(date +%s)" "$REASON_DISPLAY" "$SESSION_ID" > "$RESET_REASON_FILE.tmp.$$" && mv "$RESET_REASON_FILE.tmp.$$" "$RESET_REASON_FILE"
fi

# Clean up this session's per-session state files
rm -f "$WARDEN_STATE_DIR/.session_start-$SESSION_ID" 2>/dev/null
rm -f "$WARDEN_STATE_DIR/startup-model-$SESSION_ID" 2>/dev/null
rm -f "$WARDEN_STATE_DIR/subagent-count-$SESSION_ID" 2>/dev/null
# Remove tool-start and quiet-override markers for this session
rm -f "$WARDEN_STATE_DIR"/.tool-start-*-"$SESSION_ID" 2>/dev/null
rm -f "$WARDEN_STATE_DIR"/.quiet-override-*-"$SESSION_ID" 2>/dev/null
rm -f "$WARDEN_STATE_DIR/session-$SESSION_ID" 2>/dev/null
# Remove per-session lock files + legacy lock dirs
rm -f "$WARDEN_STATE_DIR/session-$SESSION_ID.lock" 2>/dev/null
rm -f "$WARDEN_STATE_DIR/subagent-count-$SESSION_ID.lock" 2>/dev/null
rm -rf "$WARDEN_STATE_DIR/session-$SESSION_ID.lock.d" 2>/dev/null
rm -rf "$WARDEN_STATE_DIR/subagent-count-$SESSION_ID.lock.d" 2>/dev/null

# Delay prom file deletion so Prometheus can scrape the final state.
# Write tombstone, then schedule background cleanup after 60s (one scrape
# interval). This ensures cleanup happens even when no statusline renders
# after the last session exits.
if [[ -f "$SESSION_PROM_FILE" ]]; then
    printf '%d\n' "$(date +%s)" > "$SESSION_PROM_FILE.tombstone" 2>/dev/null
    # Background reaper: wait for Prometheus to scrape, then delete both files
    (sleep 60 && rm -f "$SESSION_PROM_FILE" "$SESSION_PROM_FILE.tombstone" 2>/dev/null) & disown
else
    rm -f "$SESSION_PROM_FILE" "$SESSION_PROM_FILE.tombstone" 2>/dev/null
fi

exit 0
