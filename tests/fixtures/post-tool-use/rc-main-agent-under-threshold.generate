#!/usr/bin/env bash
# Generate a 310-line Python file — above subagent threshold but below main agent threshold (350)
{
  echo "import os"
  echo "import sys"
  echo ""
  for i in $(seq 1 100); do
    echo "def func_${i}():"
    echo "    # implementation"
    echo "    return $i"
  done
} | jq -Rs --arg fp "src/funcs.py" \
  '{"tool_name":"Read","tool_input":{"file_path":$fp},"tool_response":{"content":[{"type":"text","text":.}]},"session_id":"test-session","transcript_path":"/tmp/main.jsonl"}'
