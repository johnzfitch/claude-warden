*.bak
*.bak.*
*.tmp
.venv/

# Claude Code frame timing log — CLAUDE_CODE_FRAME_TIMING_LOG=1 writes a file
# literally named "1" to $CWD.  The Copilot coding agent's `git add .` will
# pick it up and commit it (170 K lines in the original incident, see
# e00d6d7b74fd).  This gitignore entry prevents that.
/1

# Internal design/planning docs
DESIGN-*.md
plan.md

# Internal security reports
*-threat-model.md
CLAUDE.md
info.md
*-security-audit.md

# Internal analysis reports (generated locally)
docs/ANALYSIS.md
docs/ANALYSIS-*.md

# Python bytecode (optional token counting helper validation)
__pycache__/
*.py[cod]

# Claude Code local state (keep the repo clean by default)
.claude/settings.local.json
.claude/worktrees/

# User config overrides (created from config/user.json.template)
config/user.json

# Generated shell env helper (written to ~/.claude/.warden/ by install.sh)
warden.env.sh

# Common editor/OS noise
.DS_Store
.idea/
.vscode/

# Test result logs (generated locally)
test-output.log
tests/verbosity/results.txt

# Demo artifacts
demo/claude-warden-demo.mp4
demo/claude-warden-demo.gif
demo/install.gif
demo/install.mp4
demo/mock-inputs/pre-tool-use-write-large.json

# Manim render cache (SVG/TeX/image fragments generated during rendering)
demo/manim/media/
demo/manim/exports/

# Go build artifacts
collector/collector
collector/warden-collector

# Scratch directories
playground/
target/

# Claude Code project config (auto-generated)
.claude/
